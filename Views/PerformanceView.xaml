<UserControl x:Class="Veltrix.Views.PerformanceView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel Margin="0,0,0,12"><TextBlock Text="Network Performance" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="ICMP probe to 1.1.1.1 • rolling 60 probes" Foreground="#94A3B8"/></StackPanel>
<UniformGrid Grid.Row="1" Columns="2" Margin="0,0,0,8">
<Border Style="{StaticResource DashboardCard}" Margin="4" Padding="12"><StackPanel><TextBlock Text="LATENCY" Foreground="#94A3B8"/><TextBlock x:Name="Latency" Text="—" FontSize="23" Foreground="#22D3EE"/></StackPanel></Border>
<Border Style="{StaticResource DashboardCard}" Margin="4" Padding="12"><StackPanel><TextBlock Text="PACKET LOSS" Foreground="#94A3B8"/><TextBlock x:Name="Loss" Text="—" FontSize="23" Foreground="#22D3EE"/></StackPanel></Border>
<Border Style="{StaticResource DashboardCard}" Margin="4" Padding="12"><StackPanel><TextBlock Text="PROBE UPTIME" Foreground="#94A3B8"/><TextBlock x:Name="Uptime" Text="—" FontSize="23" Foreground="#22D3EE"/></StackPanel></Border>
<Border Style="{StaticResource DashboardCard}" Margin="4" Padding="12"><StackPanel><TextBlock Text="JITTER" Foreground="#94A3B8"/><TextBlock x:Name="Jitter" Text="—" FontSize="23" Foreground="#22D3EE"/></StackPanel></Border>
<Border Style="{StaticResource DashboardCard}" Margin="4" Padding="12"><StackPanel><TextBlock Text="PEAK DOWNLOAD" Foreground="#94A3B8"/><TextBlock x:Name="PeakDown" Text="—" FontSize="23" Foreground="#22D3EE"/></StackPanel></Border>
<Border Style="{StaticResource DashboardCard}" Margin="4" Padding="12"><StackPanel><TextBlock Text="PEAK UPLOAD" Foreground="#94A3B8"/><TextBlock x:Name="PeakUp" Text="—" FontSize="23" Foreground="#22D3EE"/></StackPanel></Border>
</UniformGrid><Border Grid.Row="2" Style="{StaticResource DashboardCard}" Padding="12" Margin="4"><DockPanel><TextBlock DockPanel.Dock="Top" Text="Latency history (ms)" Margin="0,0,0,8"/><Canvas x:Name="Plot" ClipToBounds="True" SizeChanged="Plot_SizeChanged"/></DockPanel></Border><Border Grid.Row="3" Style="{StaticResource DashboardCard}" Margin="4" Padding="12"><StackPanel><TextBlock Text="Veltrix resource usage"/><TextBlock x:Name="ResourcesText" Foreground="#94A3B8"/><TextBlock x:Name="ProbeStatus" Foreground="#94A3B8" Text="Waiting for probe"/></StackPanel></Border></Grid></UserControl>