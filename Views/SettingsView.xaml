<UserControl x:Class="Veltrix.Views.SettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<UserControl.Resources>
<Style TargetType="CheckBox"><Setter Property="Foreground" Value="#F8FAFC"/><Setter Property="Margin" Value="0,5"/><Setter Property="FontSize" Value="13"/></Style>
<Style x:Key="Action" TargetType="Button"><Setter Property="Foreground" Value="#F8FAFC"/><Setter Property="Background" Value="#1E293B"/><Setter Property="Padding" Value="14,7"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="#475569" BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}"><TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#164E63"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="NetworkScrollThumb" TargetType="Thumb">
   <Setter Property="Background" Value="#64748B"/>
   <Setter Property="Template"><Setter.Value>
    <ControlTemplate TargetType="Thumb">
     <Border x:Name="Grip" Background="{TemplateBinding Background}" CornerRadius="5" Margin="2,1"/>
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Grip" Property="Background" Value="#22D3EE"/></Trigger>
      <Trigger Property="IsDragging" Value="True"><Setter TargetName="Grip" Property="Background" Value="#0891B2"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value></Setter>
  </Style>
  <Style x:Key="NetworkScrollPage" TargetType="RepeatButton">
   <Setter Property="Focusable" Value="False"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></Setter.Value></Setter>
  </Style>

    <Style TargetType="ScrollBar">
     <Setter Property="Width" Value="14"/>
     <Setter Property="MinWidth" Value="14"/>
     <Setter Property="Background" Value="#1E293B"/>
     <Setter Property="Template"><Setter.Value>
      <ControlTemplate TargetType="ScrollBar">
       <Border Background="{TemplateBinding Background}" CornerRadius="7" Margin="1,0">
        <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" ViewportSize="{TemplateBinding ViewportSize}" Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
         <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource NetworkScrollPage}" Command="ScrollBar.PageUpCommand"/></Track.DecreaseRepeatButton>
         <Track.Thumb><Thumb Style="{StaticResource NetworkScrollThumb}" MinHeight="24"/></Track.Thumb>
         <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource NetworkScrollPage}" Command="ScrollBar.PageDownCommand"/></Track.IncreaseRepeatButton>
        </Track>
       </Border>
      </ControlTemplate>
     </Setter.Value></Setter>
    </Style>
   </UserControl.Resources>
<Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel Margin="0,0,0,10"><TextBlock Text="Settings" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Personalize your Veltrix experience." Foreground="#94A3B8"/></StackPanel>
<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,10,0">
<Border Style="{StaticResource DashboardCard}" Padding="14" Margin="0,0,0,10"><StackPanel><TextBlock Text="General settings" FontSize="16" FontWeight="SemiBold"/><CheckBox x:Name="Startup" Content="Start with Windows"/><CheckBox x:Name="Minimized" Content="Start minimized to system tray"/></StackPanel></Border>
<Border Style="{StaticResource DashboardCard}" Padding="14" Margin="0,0,0,10"><StackPanel><TextBlock Text="Mini Speed Meter" FontSize="16" FontWeight="SemiBold"/><CheckBox x:Name="OpenMini" Content="Open Mini Meter at startup"/><CheckBox x:Name="AlwaysTop" Content="Always on top"/><CheckBox x:Name="Remember" Content="Remember window position"/><TextBlock Text="Opacity (50–100%)" Margin="0,6"/><Slider x:Name="OpacitySlider" Minimum="50" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"/><TextBlock Text="{Binding Value, ElementName=OpacitySlider, StringFormat={}{0:0}%}" Foreground="#22D3EE"/></StackPanel></Border>
<Border Style="{StaticResource DashboardCard}" Padding="14"><StackPanel><TextBlock Text="Monitoring preferences" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Speed units" Margin="0,8,0,4"/><StackPanel Orientation="Horizontal"><RadioButton x:Name="AutoUnits" Content="Auto" Foreground="#F8FAFC" Margin="0,0,16,0" GroupName="Units"/><RadioButton x:Name="KbUnits" Content="KB/s" Foreground="#F8FAFC" Margin="0,0,16,0" GroupName="Units"/><RadioButton x:Name="MbpsUnits" Content="Mbps" Foreground="#F8FAFC" GroupName="Units"/></StackPanel><TextBlock Text="Refresh interval" Margin="0,10,0,4"/><StackPanel Orientation="Horizontal"><RadioButton x:Name="Half" Content="0.5s" Foreground="#F8FAFC" Margin="0,0,16,0" GroupName="Interval"/><RadioButton x:Name="One" Content="1s" Foreground="#F8FAFC" Margin="0,0,16,0" GroupName="Interval"/><RadioButton x:Name="Two" Content="2s" Foreground="#F8FAFC" Margin="0,0,16,0" GroupName="Interval"/><RadioButton x:Name="Five" Content="5s" Foreground="#F8FAFC" GroupName="Interval"/></StackPanel></StackPanel></Border>
</StackPanel></ScrollViewer><StackPanel Grid.Row="2" Margin="0,10,0,0"><StackPanel Orientation="Horizontal"><Button Style="{StaticResource Action}" Content="Save settings" Click="Save_Click"/><Button Style="{StaticResource Action}" Content="Reset defaults" Click="Reset_Click"/></StackPanel><TextBlock x:Name="Status" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel></Grid></UserControl>
