<UserControl x:Class="Veltrix.Views.DataUsageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>

        <!-- FILTER BUTTON STYLE -->

        <Style x:Key="FilterButtonStyle"
               TargetType="Button">

            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                TextElement.Foreground="{TemplateBinding Foreground}"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">

                                <Setter TargetName="Chrome"
                                        Property="Background"
                                        Value="#334155"/>

                                <Setter Property="Foreground"
                                        Value="#22D3EE"/>

                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">

                                <Setter TargetName="Chrome"
                                        Property="Background"
                                        Value="#164E63"/>

                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">

                                <Setter Property="Opacity"
                                        Value="0.5"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

        </Style>


        <!-- CALENDAR DAY BUTTON STYLE -->

        <Style x:Key="VisibleCalendarDayButton"
               TargetType="{x:Type CalendarDayButton}">

            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="{x:Type CalendarDayButton}">

                        <Border x:Name="DayBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="4"
                                Margin="1">

                            <TextBlock Text="{TemplateBinding Content}"
           Foreground="{TemplateBinding Foreground}"
           HorizontalAlignment="Center"
           VerticalAlignment="Center"
           FontSize="12"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsInactive" Value="True">

                                <Setter Property="Foreground"
                                        Value="#94A3B8"/>

                            </Trigger>

                            <Trigger Property="IsToday" Value="True">

                                <Setter TargetName="DayBorder"
                                        Property="BorderBrush"
                                        Value="#0891B2"/>

                            </Trigger>

                            <Trigger Property="IsMouseOver" Value="True">

                                <Setter TargetName="DayBorder"
                                        Property="Background"
                                        Value="#CFFAFE"/>

                                <Setter Property="Foreground"
                                        Value="#155E75"/>

                            </Trigger>

                            <Trigger Property="IsSelected" Value="True">

                                <Setter TargetName="DayBorder"
                                        Property="Background"
                                        Value="#0891B2"/>

                                <Setter Property="Foreground"
                                        Value="#FFFFFF"/>

                            </Trigger>

                            <Trigger Property="IsBlackedOut" Value="True">

                                <Setter Property="Foreground"
                                        Value="#CBD5E1"/>

                                <Setter TargetName="DayBorder"
                                        Property="Background"
                                        Value="#F1F5F9"/>

                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">

                                <Setter Property="Opacity"
                                        Value="0.4"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- CALENDAR MONTH / YEAR BUTTON STYLE -->

        <Style x:Key="VisibleCalendarButton"
               TargetType="{x:Type CalendarButton}">

            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="{x:Type CalendarButton}">

                        <Border x:Name="MonthBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Margin="2">

                            <TextBlock Text="{TemplateBinding Content}"
           Foreground="{TemplateBinding Foreground}"
           HorizontalAlignment="Center"
           VerticalAlignment="Center"
           FontSize="12"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsInactive" Value="True">

                                <Setter Property="Foreground"
                                        Value="#94A3B8"/>

                            </Trigger>

                            <Trigger Property="IsMouseOver" Value="True">

                                <Setter TargetName="MonthBorder"
                                        Property="Background"
                                        Value="#CFFAFE"/>

                            </Trigger>

                            <Trigger Property="HasSelectedDays" Value="True">

                                <Setter TargetName="MonthBorder"
                                        Property="Background"
                                        Value="#0891B2"/>

                                <Setter Property="Foreground"
                                        Value="#FFFFFF"/>

                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">

                                <Setter Property="Opacity"
                                        Value="0.4"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- CALENDAR POPUP STYLE -->

        <Style x:Key="VisibleCalendarStyle"
               TargetType="{x:Type Calendar}">

            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>

            <Setter Property="CalendarDayButtonStyle"
                    Value="{StaticResource VisibleCalendarDayButton}"/>

            <Setter Property="CalendarButtonStyle"
                    Value="{StaticResource VisibleCalendarButton}"/>

            <Style.Resources>

                <Style TargetType="{x:Type TextBlock}">
                    <Setter Property="Foreground" Value="#0F172A"/>
                    <Setter Property="FontFamily" Value="Segoe UI"/>
                </Style>

                <Style TargetType="{x:Type Button}">

                    <Setter Property="Foreground" Value="#0F172A"/>

                    <Setter Property="Template">
                        <Setter.Value>

                            <ControlTemplate TargetType="{x:Type Button}">

                                <Border Background="Transparent"
                            Padding="3">

                                    <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">

                                        <ContentPresenter.Resources>

                                            <Style TargetType="{x:Type TextBlock}">
                                                <Setter Property="Foreground"
                                            Value="#0F172A"/>
                                            </Style>

                                        </ContentPresenter.Resources>

                                    </ContentPresenter>

                                </Border>

                            </ControlTemplate>

                        </Setter.Value>
                    </Setter>

                </Style>

            </Style.Resources>

        </Style>


        <!-- DATE PICKER STYLE -->

        <Style x:Key="VisibleDatePickerStyle"
               TargetType="{x:Type DatePicker}">

            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#64748B"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="SelectedDateFormat" Value="Short"/>

            <Setter Property="CalendarStyle"
                    Value="{StaticResource VisibleCalendarStyle}"/>

            <Style.Resources>

                <Style TargetType="{x:Type DatePickerTextBox}">

                    <Setter Property="Foreground"
                            Value="#0F172A"/>

                    <Setter Property="Background"
                            Value="#F8FAFC"/>

                    <Setter Property="CaretBrush"
                            Value="#0F172A"/>

                    <Style.Resources>

                        <Style TargetType="{x:Type TextBlock}">

                            <Setter Property="Foreground"
                                    Value="#475569"/>

                        </Style>

                    </Style.Resources>

                </Style>

                <Style TargetType="{x:Type Button}">

                    <Setter Property="Foreground"
                            Value="#0F172A"/>

                </Style>

            </Style.Resources>

        </Style>

    </UserControl.Resources>


    <!-- MAIN LAYOUT -->

    <Grid>

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>

        </Grid.RowDefinitions>


        <!-- PAGE HEADER -->

        <StackPanel Margin="0,0,0,10">

            <TextBlock Text="Data Usage"
                       FontSize="24"
                       FontWeight="SemiBold"/>

            <TextBlock
                Text="Analyze your recorded network consumption"
                Foreground="#94A3B8"/>

        </StackPanel>


        <!-- PERIOD FILTERS -->

        <StackPanel Grid.Row="1"
                    Margin="0,0,0,10">

            <StackPanel Orientation="Horizontal">

                <Button Content="This Week"
                        Style="{StaticResource FilterButtonStyle}"
                        Tag="week"
                        Click="Period_Click"
                        Padding="12,5"
                        Margin="0,0,6,0"/>

                <Button Content="This Month"
                        Style="{StaticResource FilterButtonStyle}"
                        Tag="month"
                        Click="Period_Click"
                        Padding="12,5"
                        Margin="0,0,6,0"/>

                <Button Content="This Year"
                        Style="{StaticResource FilterButtonStyle}"
                        Tag="year"
                        Click="Period_Click"
                        Padding="12,5"
                        Margin="0,0,6,0"/>

                <Button Content="Custom"
                        Style="{StaticResource FilterButtonStyle}"
                        Tag="custom"
                        Click="Period_Click"
                        Padding="12,5"/>

            </StackPanel>


            <!-- CUSTOM DATE RANGE -->

            <StackPanel x:Name="CustomPanel"
                        Orientation="Horizontal"
                        Visibility="Collapsed"
                        Margin="0,8,0,0">

                <DatePicker x:Name="StartPicker"
                            Width="140"
                            Style="{StaticResource VisibleDatePickerStyle}"/>

                <TextBlock Text="to"
                           Foreground="#94A3B8"
                           VerticalAlignment="Center"
                           Margin="10,0"/>

                <DatePicker x:Name="EndPicker"
                            Width="140"
                            Style="{StaticResource VisibleDatePickerStyle}"/>

                <Button Content="Apply"
                        Style="{StaticResource FilterButtonStyle}"
                        Click="Apply_Click"
                        Margin="8,0,0,0"
                        Padding="12,4"/>

            </StackPanel>

            <TextBlock x:Name="RangeText"
                       Foreground="#94A3B8"
                       Margin="0,5,0,0"/>

        </StackPanel>


        <!-- USAGE SUMMARY CARDS -->

        <UniformGrid Grid.Row="2"
                     Columns="3"
                     Margin="0,0,0,10">

            <!-- TOTAL USAGE -->

            <Border Style="{StaticResource DashboardCard}"
                    Padding="12"
                    Margin="0,0,5,0">

                <StackPanel>

                    <TextBlock Text="TOTAL USAGE"
                               Foreground="#94A3B8"/>

                    <TextBlock x:Name="TotalText"
                               FontSize="24"
                               Foreground="#22D3EE"/>

                </StackPanel>

            </Border>


            <!-- DOWNLOAD -->

            <Border Style="{StaticResource DashboardCard}"
                    Padding="12"
                    Margin="5,0">

                <StackPanel>

                    <TextBlock Text="DOWNLOAD"
                               Foreground="#94A3B8"/>

                    <TextBlock x:Name="DownText"
                               FontSize="24"
                               Foreground="#34D399"/>

                </StackPanel>

            </Border>


            <!-- UPLOAD -->

            <Border Style="{StaticResource DashboardCard}"
                    Padding="12"
                    Margin="5,0,0,0">

                <StackPanel>

                    <TextBlock Text="UPLOAD"
                               Foreground="#94A3B8"/>

                    <TextBlock x:Name="UpText"
                               FontSize="24"
                               Foreground="#818CF8"/>

                </StackPanel>

            </Border>

        </UniformGrid>


        <!-- USAGE CHART -->

        <Border Grid.Row="3"
                Style="{StaticResource DashboardCard}"
                Padding="12"
                Margin="0,0,0,10">

            <DockPanel>

                <TextBlock DockPanel.Dock="Top"
                           Text="Usage overview  •  Green: Download  /  Purple: Upload"
                           Margin="0,0,0,8"/>

                <Canvas x:Name="ChartCanvas"
                        ClipToBounds="True"
                        SizeChanged="Chart_SizeChanged"/>

            </DockPanel>

        </Border>


        <!-- USAGE BREAKDOWN -->

        <Border Grid.Row="4"
                Style="{StaticResource DashboardCard}"
                Padding="12">

            <StackPanel>

                <TextBlock Text="Usage breakdown"
                           FontWeight="SemiBold"/>

                <Grid Height="12"
                      Margin="0,8">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition x:Name="DownColumn"/>
                        <ColumnDefinition x:Name="UpColumn"/>

                    </Grid.ColumnDefinitions>

                    <Border x:Name="DownBar"
                            Background="#34D399"/>

                    <Border x:Name="UpBar"
                            Grid.Column="1"
                            Background="#818CF8"/>

                </Grid>

                <TextBlock x:Name="BreakdownText"/>

                <TextBlock x:Name="StatusText"
                           Foreground="#94A3B8"
                           FontSize="11"/>

            </StackPanel>

        </Border>

    </Grid>

</UserControl>
