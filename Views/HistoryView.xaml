<UserControl x:Class="Veltrix.Views.HistoryView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <UserControl.Resources>
  <Style x:Key="HistoryButton" TargetType="Button">
   <Setter Property="Foreground" Value="#F8FAFC"/><Setter Property="Background" Value="#1E293B"/><Setter Property="Padding" Value="12,6"/><Setter Property="Margin" Value="0,0,6,0"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}" BorderBrush="#334155" BorderThickness="1"><TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#334155"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
 </UserControl.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,10"><TextBlock Text="Usage History" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="View and export recorded network usage" Foreground="#94A3B8"/></StackPanel>
  <StackPanel Grid.Row="1" Margin="0,0,0,10">
   <WrapPanel><Button Style="{StaticResource HistoryButton}" Content="This Week" Tag="week" Click="Period_Click"/><Button Style="{StaticResource HistoryButton}" Content="This Month" Tag="month" Click="Period_Click"/><Button Style="{StaticResource HistoryButton}" Content="This Year" Tag="year" Click="Period_Click"/><Button Style="{StaticResource HistoryButton}" Content="Refresh" Click="Refresh_Click"/><Button Style="{StaticResource HistoryButton}" Content="Export CSV" Click="Export_Click" Foreground="#22D3EE"/></WrapPanel>
   <WrapPanel Margin="0,8,0,0"><TextBlock Text="From" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBox x:Name="StartText" Width="110" Background="#151E30" Foreground="#F8FAFC" Padding="5"/><TextBlock Text="To" VerticalAlignment="Center" Margin="8,0"/><TextBox x:Name="EndText" Width="110" Background="#151E30" Foreground="#F8FAFC" Padding="5"/><Button Style="{StaticResource HistoryButton}" Content="Apply" Click="Apply_Click" Margin="8,0,0,0"/><TextBlock Text="yyyy-MM-dd" Foreground="#94A3B8" VerticalAlignment="Center" Margin="8,0"/></WrapPanel>
  </StackPanel>
  <UniformGrid Grid.Row="2" Columns="3" Margin="0,0,0,10">
   <Border Style="{StaticResource DashboardCard}" Padding="10" Margin="0,0,5,0"><StackPanel><TextBlock Text="TOTAL USAGE" Foreground="#94A3B8"/><TextBlock x:Name="TotalText" FontSize="20" Foreground="#22D3EE"/></StackPanel></Border>
   <Border Style="{StaticResource DashboardCard}" Padding="10" Margin="5,0"><StackPanel><TextBlock Text="DAILY AVERAGE" Foreground="#94A3B8"/><TextBlock x:Name="AverageText" FontSize="20" Foreground="#34D399"/></StackPanel></Border>
   <Border Style="{StaticResource DashboardCard}" Padding="10" Margin="5,0,0,0"><StackPanel><TextBlock Text="HIGHEST RECORDED DAY" Foreground="#94A3B8"/><TextBlock x:Name="HighestText" FontSize="18" Foreground="#818CF8"/></StackPanel></Border>
  </UniformGrid>
  <DataGrid Grid.Row="3" x:Name="HistoryGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserSortColumns="False" HeadersVisibility="Column" Background="#151E30" Foreground="#F8FAFC" RowBackground="#151E30" AlternatingRowBackground="#1E293B" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#263449" BorderBrush="#334155" RowHeight="30">
   <DataGrid.Resources><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#F8FAFC"/><Setter Property="VerticalAlignment" Value="Center"/></Style><Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#263449"/><Setter Property="Foreground" Value="#F8FAFC"/><Setter Property="Padding" Value="8"/></Style></DataGrid.Resources>
   <DataGrid.Columns><DataGridTextColumn Header="Date" Binding="{Binding DateLabel}" Width="*"/><DataGridTextColumn Header="Download" Binding="{Binding DownloadLabel}" Width="*"/><DataGridTextColumn Header="Upload" Binding="{Binding UploadLabel}" Width="*"/><DataGridTextColumn Header="Total" Binding="{Binding TotalLabel}" Width="*"/></DataGrid.Columns>
  </DataGrid>
  <DockPanel Grid.Row="4" Margin="0,8,0,0"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="PrevButton" Style="{StaticResource HistoryButton}" Content="Previous" Click="Prev_Click"/><Button x:Name="NextButton" Style="{StaticResource HistoryButton}" Content="Next" Click="Next_Click"/></StackPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Style="{StaticResource HistoryButton}" Content="Sort date" Tag="date" Click="Sort_Click"/><Button Style="{StaticResource HistoryButton}" Content="Sort total" Tag="total" Click="Sort_Click"/></StackPanel><TextBlock x:Name="StatusText" Foreground="#94A3B8" VerticalAlignment="Center" TextWrapping="Wrap"/></DockPanel>
 </Grid>
</UserControl>
