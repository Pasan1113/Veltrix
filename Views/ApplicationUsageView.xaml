<UserControl x:Class="Veltrix.Views.ApplicationUsageView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<UserControl.Resources>
<Style x:Key="Action" TargetType="Button"><Setter Property="Background" Value="#1E293B"/><Setter Property="Foreground" Value="#F8FAFC"/><Setter Property="Padding" Value="12,6"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="#475569" BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}"><TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#164E63"/><Setter Property="Foreground" Value="#22D3EE"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
<Style TargetType="ScrollBar"><Setter Property="Width" Value="14"/><Setter Property="Background" Value="#1E293B"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Border Background="#1E293B" CornerRadius="7"><Track x:Name="PART_Track" IsDirectionReversed="True"><Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border x:Name="Grip" Background="#94A3B8" CornerRadius="5" Margin="2"/><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Grip" Property="Background" Value="#22D3EE"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0"/></Track.IncreaseRepeatButton></Track></Border></ControlTemplate></Setter.Value></Setter></Style>
</UserControl.Resources>
<Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel><TextBlock Text="Application Usage" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="TCP / UDP traffic by process name • all adapters" Foreground="#94A3B8" Margin="0,4,0,10"/></StackPanel>
<StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10"><Button Content="Today" Style="{StaticResource Action}" Click="Today_Click"/><Button Content="This month" Style="{StaticResource Action}" Click="Month_Click"/><Button Content="Sort by usage / speed" Style="{StaticResource Action}" Click="Sort_Click"/><TextBox x:Name="Search" Width="150" Background="#1E293B" Foreground="#F8FAFC" CaretBrush="White" Padding="5" TextChanged="Search_Changed"/></StackPanel>
        <Border Grid.Row="2" Style="{StaticResource DashboardCard}" Padding="12" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock x:Name="Summary" Foreground="#22D3EE" TextWrapping="Wrap"/>
                <TextBlock Text="Top data consumers" Margin="0,8,0,4"/>
                <ItemsControl x:Name="TopRows">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                <ProgressBar Grid.Column="1" Height="8" Minimum="0" Maximum="100" Value="{Binding Percent, Mode=OneWay}" Foreground="#22D3EE" Background="#263449" BorderThickness="0"/><TextBlock Grid.Column="2" Text="{Binding Usage}" HorizontalAlignment="Right"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
<Border Grid.Row="3" Style="{StaticResource DashboardCard}" Padding="10"><DockPanel><Grid DockPanel.Dock="Top" Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="Application" Foreground="#94A3B8"/><TextBlock Grid.Column="1" Text="Download" Foreground="#94A3B8"/><TextBlock Grid.Column="2" Text="Upload" Foreground="#94A3B8"/><TextBlock Grid.Column="3" Text="Total usage" Foreground="#94A3B8"/></Grid><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsControl x:Name="Rows"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="#263449" BorderThickness="0,0,0,1" Padding="0,9"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="1" Text="{Binding Down}" Foreground="#34D399"/><TextBlock Grid.Column="2" Text="{Binding Up}" Foreground="#818CF8"/><TextBlock Grid.Column="3" Text="{Binding Total}" Foreground="#22D3EE"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></DockPanel></Border>
<TextBlock Grid.Row="4" x:Name="Status" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,8,0,0"/>
</Grid></UserControl>
