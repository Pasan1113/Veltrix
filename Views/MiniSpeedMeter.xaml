<Window x:Class="Veltrix.Views.MiniSpeedMeter"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Veltrix Mini Meter"
        Width="235"
        Height="125"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        WindowStartupLocation="Manual">

    <Border Background="#0F172A"
            BorderBrush="#334155"
            BorderThickness="1"
            CornerRadius="12"
            Padding="12"
            MouseLeftButtonDown="Meter_MouseLeftButtonDown">

        <Border.ContextMenu>

            <ContextMenu>

                <MenuItem Header="Always on top"
                  IsCheckable="True"
                  IsChecked="True"
                  Click="AlwaysOnTop_Click"/>

                <Separator/>

                <MenuItem Header="Opacity">

                    <MenuItem Header="100%"
                      Tag="1"
                      Click="Opacity_Click"/>

                    <MenuItem Header="90%"
                      Tag="0.9"
                      Click="Opacity_Click"/>

                    <MenuItem Header="75%"
                      Tag="0.75"
                      Click="Opacity_Click"/>

                    <MenuItem Header="50%"
                      Tag="0.5"
                      Click="Opacity_Click"/>

                </MenuItem>

                <Separator/>

                <MenuItem Header="Close mini meter"
                  Foreground="#F87171"
                  Click="CloseMeter_Click"/>

            </ContextMenu>

        </Border.ContextMenu>

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="25"/>
                <RowDefinition Height="1"/>
                <RowDefinition Height="30"/>
                <RowDefinition Height="30"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->

            <Grid Grid.Row="0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <Path Data="M 0,0 L 7,0 L 16,20 L 25,0 L 32,0 L 16,32 Z"
                          Fill="#22D3EE"
                          Width="14"
                          Height="14"
                          Stretch="Uniform"/>

                    <TextBlock Text="V E L T R I X"
                               Foreground="#22D3EE"
                               FontSize="10"
                               FontWeight="Bold"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"/>

                </StackPanel>

                <Button Grid.Column="1"
                        Content="✕"
                        Width="22"
                        Height="22"
                        Background="Transparent"
                        Foreground="#94A3B8"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="CloseMeter_Click">

                    <Button.Template>

                        <ControlTemplate TargetType="Button">

                            <Border x:Name="CloseBackground"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="5">

                                <ContentPresenter
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>

                            </Border>

                            <ControlTemplate.Triggers>

                                <Trigger Property="IsMouseOver"
                                         Value="True">

                                    <Setter TargetName="CloseBackground"
                                            Property="Background"
                                            Value="#EF4444"/>

                                    <Setter Property="Foreground"
                                            Value="White"/>

                                </Trigger>

                            </ControlTemplate.Triggers>

                        </ControlTemplate>

                    </Button.Template>

                </Button>

            </Grid>

            <!-- DIVIDER -->

            <Border Grid.Row="1"
                    Background="#263449"/>

            <!-- DOWNLOAD SPEED -->

            <Grid Grid.Row="2">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="↓"
                           Foreground="#34D399"
                           FontSize="21"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>

                <TextBlock x:Name="MiniDownloadText"
                           Grid.Column="1"
                           Text="0.00 B/s"
                           Foreground="#F8FAFC"
                           FontSize="16"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Column="2"
                           Text="DL"
                           Foreground="#64748B"
                           FontSize="10"
                           VerticalAlignment="Center"/>

            </Grid>

            <!-- UPLOAD SPEED -->

            <Grid Grid.Row="3">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="↑"
                           Foreground="#818CF8"
                           FontSize="21"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>

                <TextBlock x:Name="MiniUploadText"
                           Grid.Column="1"
                           Text="0.00 B/s"
                           Foreground="#F8FAFC"
                           FontSize="16"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Column="2"
                           Text="UL"
                           Foreground="#64748B"
                           FontSize="10"
                           VerticalAlignment="Center"/>

            </Grid>

        </Grid>

    </Border>

</Window>