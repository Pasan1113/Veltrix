<UserControl x:Class="Veltrix.Views.DataLimitView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<UserControl.Resources>
<Style x:Key="SaveButton" TargetType="Button"><Setter Property="Background" Value="#164E63"/><Setter Property="Foreground" Value="#F8FAFC"/><Setter Property="Padding" Value="16,8"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}"><TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#155E75"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
</UserControl.Resources>
<Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel Margin="0,0,0,10"><TextBlock Text="Data Limit" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Manage your internet package and usage alerts." Foreground="#94A3B8"/></StackPanel>
<Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Style="{StaticResource DashboardCard}" Padding="16" Margin="0,0,6,0"><StackPanel><TextBlock Text="CURRENT BILLING CYCLE" Foreground="#94A3B8"/><Grid Width="160" Height="160" Margin="0,12"><Ellipse Stroke="#263449" StrokeThickness="12"/><Path x:Name="Ring" Stroke="#22D3EE" StrokeThickness="12" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/><TextBlock x:Name="PercentText" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid><TextBlock x:Name="UsedText" FontSize="20" Foreground="#22D3EE"/><TextBlock x:Name="RemainingText" Foreground="#34D399" Margin="0,8,0,0"/><TextBlock x:Name="CycleText" Foreground="#94A3B8" Margin="0,8,0,0"/><TextBlock x:Name="ForecastText" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Border>
<Border Grid.Column="1" Style="{StaticResource DashboardCard}" Padding="16" Margin="6,0,0,0"><StackPanel><TextBlock Text="Package settings" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Data limit (GB)" Margin="0,12,0,4"/><TextBox x:Name="LimitBox" Background="#1E293B" Foreground="#F8FAFC" CaretBrush="#F8FAFC" Padding="6"/><TextBlock Text="Billing start day (1–31)" Margin="0,10,0,4"/><TextBox x:Name="DayBox" Background="#1E293B" Foreground="#F8FAFC" CaretBrush="#F8FAFC" Padding="6"/><CheckBox x:Name="EnabledBox" Foreground="#F8FAFC" Margin="0,12,0,8" Content="Enable usage notifications"/><WrapPanel Margin="0,4,0,12"><CheckBox x:Name="T50" Foreground="#F8FAFC" Content="50%" Margin="0,0,10,0"/><CheckBox x:Name="T80" Foreground="#F8FAFC" Content="80%" Margin="0,0,10,0"/><CheckBox x:Name="T90" Foreground="#F8FAFC" Content="90%" Margin="0,0,10,0"/><CheckBox x:Name="T100" Foreground="#F8FAFC" Content="100%"/></WrapPanel><Button Style="{StaticResource SaveButton}" Content="Save settings" Click="Save_Click"/><TextBlock x:Name="StatusText" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Border></Grid>
<TextBlock Grid.Row="2" Margin="0,10,0,0" Foreground="#94A3B8" TextWrapping="Wrap" Text="Based on Veltrix recorded traffic (download + upload), not your ISP balance. Short months use the last day."/>
</Grid></UserControl>
